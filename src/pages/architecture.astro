---
import Base from "../layouts/Base.astro";
import BusTopology from "../components/diagrams/BusTopology.astro";
import AuthPath from "../components/diagrams/AuthPath.astro";
import ComplianceAgents from "../components/diagrams/ComplianceAgents.astro";
import SenPipeline from "../components/diagrams/SenPipeline.astro";
import { pipeline, type Lang } from "../data/site";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;

const systems = [
  { id: "media", label: "Media Intelligence" },
  { id: "compliance", label: "Compliance Monitor" },
  { id: "sen", label: "SEN Dashboard" },
];

const copy = {
  en: {
    title: "Architecture — Inti Cerda",
    description:
      "Flow, topology and decision diagrams for three production systems: a 16-service media platform, a compliance enrichment service and a public-sector pipeline.",
    eyebrow: "Architecture",
    heading: "Three systems, drawn the way they actually run.",
    intro:
      "Every diagram here is derived from a service that is deployed, not from a whiteboard. Pick a system.",
    legend: "Choose a system",
    ingestCaption:
      "Ingestion path — a scrape run fans out across 160+ outlets, dedups against Redis, then hands each article to a local model.",
    busCaption:
      "Event bus topology — producers never call consumers. Adding a consumer means subscribing to a stream, not editing an upstream service.",
    authCaption:
      "Request authentication — the gateway is the only component exposed to the internet. Everything behind it trusts the forwarded claims.",
    agentsCaption:
      "Enrichment flow — classified articles are filtered by regulated sector, run through a catalog of LLM agents in a VRAM-gated batch, and exposed read-only behind a single consumer.",
    separateHeading: "Why it is a separate service",
    separateBody:
      "Compliance customers are in regulated industries, so their enrichment data cannot share a boundary with the general monitoring product. It gets its own database, its own Ollama instance and exactly one permitted reader.",
    senCaption:
      "Police-news pipeline — dedup decision against a 36 hour Redis window before anything reaches the model, because the same wire story appears across a dozen outlets.",
    constraintHeading: "Constraint that shaped it",
    constraintBody:
      "Delivered to a regional public prosecutor's office. Case-adjacent material cannot go to a third-party API, so the whole stack — database, model, front end — runs in Docker on their own hardware.",
    screensLabel: "Screens",
    screensHeading: "What this looks like from the front.",
    screensBody:
      "The marketing site, the product and the internal operations panel that watches these pipelines run.",
    screensCta: "See the screens",
  },
  es: {
    title: "Arquitectura — Inti Cerda",
    description:
      "Diagramas de flujo, topología y decisiones de tres sistemas en producción: una plataforma de medios de 16 servicios, un servicio de enriquecimiento de compliance y un pipeline para el sector público.",
    eyebrow: "Arquitectura",
    heading: "Tres sistemas, dibujados como realmente corren.",
    intro:
      "Cada diagrama sale de un servicio desplegado, no de una pizarra. Elige un sistema.",
    legend: "Elige un sistema",
    ingestCaption:
      "Ruta de ingesta — una corrida de scraping se abre sobre 160+ medios, deduplica contra Redis y le pasa cada artículo a un modelo local.",
    busCaption:
      "Topología del bus de eventos — los productores nunca llaman a los consumidores. Agregar un consumidor es suscribirse a un stream, no editar un servicio aguas arriba.",
    authCaption:
      "Autenticación de requests — el gateway es el único componente expuesto a internet. Todo lo que hay detrás confía en los claims reenviados.",
    agentsCaption:
      "Flujo de enriquecimiento — los artículos clasificados se filtran por sector regulado, pasan por un catálogo de agentes LLM en un batch regulado por VRAM y se exponen en solo lectura tras un único consumidor.",
    separateHeading: "Por qué es un servicio aparte",
    separateBody:
      "Los clientes de compliance están en industrias reguladas, así que sus datos de enriquecimiento no pueden compartir frontera con el producto de monitoreo general. Tiene su propia base de datos, su propia instancia de Ollama y exactamente un lector permitido.",
    senCaption:
      "Pipeline de noticias policiales — decisión de dedup contra una ventana de 36 horas en Redis antes de que algo llegue al modelo, porque la misma nota de agencia aparece en una docena de medios.",
    constraintHeading: "La restricción que lo definió",
    constraintBody:
      "Entregado a una fiscalía regional. El material ligado a causas no puede ir a una API de terceros, así que todo el stack — base de datos, modelo, front end — corre en Docker en su propio hardware.",
    screensLabel: "Pantallas",
    screensHeading: "Cómo se ve desde el frente.",
    screensBody:
      "El sitio de marketing, el producto y el panel interno de operaciones que observa estos pipelines.",
    screensCta: "Ver las pantallas",
  },
}[lang];

const prefix = lang === "es" ? "/es" : "";
---

<Base title={copy.title} description={copy.description} lang={lang}>
  <section class="pagehead">
    <p class="pagehead__eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="pagehead__body">{copy.intro}</p>
  </section>

  <section>
    {/*
      Radio inputs rather than JS tabs: the switcher works with the keyboard
      out of the box and survives a scripting failure.
    */}
    <fieldset class="switch">
      <legend class="visually-hidden">{copy.legend}</legend>
      {
        systems.map((system, i) => (
          <>
            <input
              type="radio"
              name="system"
              id={`sys-${system.id}`}
              class="switch__input visually-hidden"
              checked={i === 0}
            />
            <label class="switch__tab" for={`sys-${system.id}`}>
              {system.label}
            </label>
          </>
        ))
      }

      <div class="switch__panels">
        <div class="switch__panel" data-for="media">
          <figure class="figure">
            <div class="figure__body">
              <ol class="flow flow--bare">
                {
                  pipeline.map((stage, i) => (
                    <li class="flow__stage" style={`--i:${i}`}>
                      <span class="flow__step">{stage.step}</span>
                      <span class="flow__name">{stage.name[lang]}</span>
                      <span class="flow__detail">{stage.detail[lang]}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
            <figcaption class="figure__caption">{copy.ingestCaption}</figcaption>
          </figure>

          <figure class="figure">
            <div class="figure__body"><BusTopology lang={lang} /></div>
            <figcaption class="figure__caption">{copy.busCaption}</figcaption>
          </figure>

          <figure class="figure">
            <div class="figure__body"><AuthPath lang={lang} /></div>
            <figcaption class="figure__caption">{copy.authCaption}</figcaption>
          </figure>
        </div>

        <div class="switch__panel" data-for="compliance">
          <figure class="figure">
            <div class="figure__body"><ComplianceAgents lang={lang} /></div>
            <figcaption class="figure__caption">{copy.agentsCaption}</figcaption>
          </figure>

          <div class="panel">
            <h2>{copy.separateHeading}</h2>
            <p class="pagehead__body">{copy.separateBody}</p>
          </div>
        </div>

        <div class="switch__panel" data-for="sen">
          <figure class="figure">
            <div class="figure__body"><SenPipeline lang={lang} /></div>
            <figcaption class="figure__caption">{copy.senCaption}</figcaption>
          </figure>

          <div class="panel">
            <h2>{copy.constraintHeading}</h2>
            <p class="pagehead__body">{copy.constraintBody}</p>
          </div>
        </div>
      </div>
    </fieldset>
  </section>

  <section>
    <p class="section__label">{copy.screensLabel}</p>
    <div class="panel reveal">
      <h2>{copy.screensHeading}</h2>
      <p class="pagehead__body">{copy.screensBody}</p>
      <div class="actions" style="margin-top:2rem">
        <a class="btn btn--solid" href={`${prefix}/screens/`}>{copy.screensCta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .switch {
    border: 0;
    margin: 0;
    padding: 0;
    /*
      Browsers give fieldset min-inline-size: min-content, so it refuses to
      shrink below its widest descendant — here a 544px diagram — and drags the
      whole page wider than the viewport, defeating the scroll container below.
    */
    min-inline-size: 0;
  }

  .switch__tab {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8125rem;
    padding: 0.625rem 1rem;
    margin: 0 0.5rem 1.5rem 0;
    border: var(--border) solid var(--rule);
    background: var(--paper);
    color: var(--muted);
    cursor: pointer;
  }

  .switch__tab:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .switch__input:checked + .switch__tab {
    color: var(--ink);
    border-color: var(--ink);
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }

  /* Keyboard focus lands on the hidden input, so surface it on the label. */
  .switch__input:focus-visible + .switch__tab {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .switch__panel {
    display: none;
  }

  .switch__input:nth-of-type(1):checked
    ~ .switch__panels
    > [data-for="media"],
  .switch__input:nth-of-type(2):checked
    ~ .switch__panels
    > [data-for="compliance"],
  .switch__input:nth-of-type(3):checked ~ .switch__panels > [data-for="sen"] {
    display: block;
  }

  .flow--bare {
    border: 0;
    margin: 0;
  }
</style>
