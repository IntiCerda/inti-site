---
import Base from "../layouts/Base.astro";
import BusTopology from "../components/diagrams/BusTopology.astro";
import AuthPath from "../components/diagrams/AuthPath.astro";
import ComplianceAgents from "../components/diagrams/ComplianceAgents.astro";
import SenPipeline from "../components/diagrams/SenPipeline.astro";
import { pipeline } from "../data/site";

const systems = [
  { id: "media", label: "Media Intelligence" },
  { id: "compliance", label: "Compliance Monitor" },
  { id: "sen", label: "SEN Dashboard" },
];
---

<Base
  title="Architecture — Inti Cerda"
  description="Flow, topology and decision diagrams for three production systems: a 16-service media platform, a compliance enrichment service and a public-sector pipeline."
>
  <section class="pagehead">
    <p class="pagehead__eyebrow">Architecture</p>
    <h1>Three systems, drawn the way they actually run.</h1>
    <p class="pagehead__body">
      Every diagram here is derived from a service that is deployed, not from a
      whiteboard. Pick a system.
    </p>
  </section>

  <section>
    {/*
      Radio inputs rather than JS tabs: the switcher works with the keyboard
      out of the box and survives a scripting failure.
    */}
    <fieldset class="switch">
      <legend class="visually-hidden">Choose a system</legend>
      {
        systems.map((system, i) => (
          <>
            <input
              type="radio"
              name="system"
              id={`sys-${system.id}`}
              class="switch__input visually-hidden"
              checked={i === 0}
            />
            <label class="switch__tab" for={`sys-${system.id}`}>
              {system.label}
            </label>
          </>
        ))
      }

      <div class="switch__panels">
        <div class="switch__panel" data-for="media">
          <figure class="figure">
            <div class="figure__body">
              <ol class="flow flow--bare">
                {
                  pipeline.map((stage, i) => (
                    <li class="flow__stage" style={`--i:${i}`}>
                      <span class="flow__step">{stage.step}</span>
                      <span class="flow__name">{stage.name}</span>
                      <span class="flow__detail">{stage.detail}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
            <figcaption class="figure__caption">
              Ingestion path — a scrape run fans out across 160+ outlets, dedups
              against Redis, then hands each article to a local model.
            </figcaption>
          </figure>

          <figure class="figure">
            <div class="figure__body"><BusTopology /></div>
            <figcaption class="figure__caption">
              Event bus topology — producers never call consumers. Adding a
              consumer means subscribing to a stream, not editing an upstream
              service.
            </figcaption>
          </figure>

          <figure class="figure">
            <div class="figure__body"><AuthPath /></div>
            <figcaption class="figure__caption">
              Request authentication — the gateway is the only component exposed
              to the internet. Everything behind it trusts the forwarded claims.
            </figcaption>
          </figure>
        </div>

        <div class="switch__panel" data-for="compliance">
          <figure class="figure">
            <div class="figure__body"><ComplianceAgents /></div>
            <figcaption class="figure__caption">
              Enrichment flow — classified articles are filtered by regulated
              sector, run through a catalog of LLM agents in a VRAM-gated batch,
              and exposed read-only behind a single consumer.
            </figcaption>
          </figure>

          <div class="panel">
            <h2>Why it is a separate service</h2>
            <p class="pagehead__body">
              Compliance customers are in regulated industries, so their
              enrichment data cannot share a boundary with the general
              monitoring product. It gets its own database, its own Ollama
              instance and exactly one permitted reader.
            </p>
          </div>
        </div>

        <div class="switch__panel" data-for="sen">
          <figure class="figure">
            <div class="figure__body"><SenPipeline /></div>
            <figcaption class="figure__caption">
              Police-news pipeline — dedup decision against a 36 hour Redis
              window before anything reaches the model, because the same wire
              story appears across a dozen outlets.
            </figcaption>
          </figure>

          <div class="panel">
            <h2>Constraint that shaped it</h2>
            <p class="pagehead__body">
              Delivered to a regional public prosecutor's office. Case-adjacent
              material cannot go to a third-party API, so the whole stack —
              database, model, front end — runs in Docker on their own hardware.
            </p>
          </div>
        </div>
      </div>
    </fieldset>
  </section>

  <section>
    <p class="section__label">Screens</p>
    <div class="panel reveal">
      <h2>What this looks like from the front.</h2>
      <p class="pagehead__body">
        The marketing site, the product and the internal operations panel that
        watches these pipelines run.
      </p>
      <div class="actions" style="margin-top:2rem">
        <a class="btn btn--solid" href="/screens/">See the screens</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .switch {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .switch__tab {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8125rem;
    padding: 0.625rem 1rem;
    margin: 0 0.5rem 1.5rem 0;
    border: var(--border) solid var(--rule);
    background: var(--paper);
    color: var(--muted);
    cursor: pointer;
  }

  .switch__tab:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .switch__input:checked + .switch__tab {
    color: var(--ink);
    border-color: var(--ink);
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }

  /* Keyboard focus lands on the hidden input, so surface it on the label. */
  .switch__input:focus-visible + .switch__tab {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .switch__panel {
    display: none;
  }

  .switch__input:nth-of-type(1):checked
    ~ .switch__panels
    > [data-for="media"],
  .switch__input:nth-of-type(2):checked
    ~ .switch__panels
    > [data-for="compliance"],
  .switch__input:nth-of-type(3):checked ~ .switch__panels > [data-for="sen"] {
    display: block;
  }

  .flow--bare {
    border: 0;
    margin: 0;
  }
</style>
