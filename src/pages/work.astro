---
import Base from "../layouts/Base.astro";
import { workSchema } from "../data/seo";
import { projects, type Lang } from "../data/site";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    title: "Work — Inti Cerda",
    description:
      "Selected projects: a 16-service media intelligence platform, a compliance product, a public-sector dashboard and open-source tooling.",
    eyebrow: "Work",
    heading: "Seven projects, one habit: ship the whole chain.",
    intro:
      "Personal products, client work and open source. Where a repository is private, the architecture is documented publicly instead.",
    projectsLabel: "Selected projects",
    contactLabel: "Contact",
    contactHeading: "Looking for a backend engineer?",
    contactBody:
      "Open to backend and platform roles, remote from Chile (UTC−4). Also available for freelance work.",
  },
  es: {
    title: "Proyectos — Inti Cerda",
    description:
      "Proyectos seleccionados: una plataforma de inteligencia de medios de 16 servicios, un producto de compliance, un dashboard para el sector público y herramientas open source.",
    eyebrow: "Proyectos",
    heading: "Siete proyectos, un hábito: entregar la cadena completa.",
    intro:
      "Productos propios, trabajo para clientes y open source. Donde el repositorio es privado, la arquitectura está documentada públicamente.",
    projectsLabel: "Proyectos seleccionados",
    contactLabel: "Contacto",
    contactHeading: "¿Buscas un ingeniero backend?",
    contactBody:
      "Disponible para roles de backend y plataforma, remoto desde Chile (UTC−4). También tomo trabajo freelance.",
  },
}[lang];
---

<Base
  title={copy.title}
  description={copy.description}
  lang={lang}
  jsonLd={workSchema(Astro.site, lang)}
>
  <section class="pagehead">
    <p class="pagehead__eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="pagehead__body">{copy.intro}</p>
  </section>

  <section>
    <p class="section__label">{copy.projectsLabel}</p>
    <div class="cards">
      {
        projects.map((project) => (
          <article class="card reveal">
            <h2>{project.name}</h2>
            <p class="card__meta">
              {project.meta[lang]} · {project.kind[lang]}
            </p>
            <p class="card__body">{project.body[lang]}</p>
            <p class="card__role">{project.role[lang]}</p>
            <ul class="tags">
              {project.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
            {project.links.length > 0 && (
              <p class="card__links">
                {project.links.map((link) => (
                  <a class="btn" href={link.href}>
                    {link.label[lang]} →
                  </a>
                ))}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <p class="section__label">{copy.contactLabel}</p>
    <div class="panel reveal">
      <h2>{copy.contactHeading}</h2>
      <p class="pagehead__body">{copy.contactBody}</p>
      <div class="actions" style="margin-top:2rem">
        <a class="btn btn--solid" href="mailto:inti.cerda.r@gmail.com">
          inti.cerda.r@gmail.com
        </a>
        <a class="btn" href="https://www.linkedin.com/in/inti-cerda/">
          LinkedIn
        </a>
      </div>
    </div>
  </section>
</Base>
