---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";

import complianceDesktop from "../assets/screens/compliance-monitor.png";
import complianceMobile from "../assets/screens/compliance-monitor-mobile.png";
import landingDesktop from "../assets/screens/media-landing.png";
import landingMobile from "../assets/screens/media-landing-mobile.png";
import adminDesktop from "../assets/screens/media-admin.png";
import adminMobile from "../assets/screens/media-admin-mobile.png";
import abogadaDesktop from "../assets/screens/javiera-abogada.png";
import abogadaMobile from "../assets/screens/javiera-abogada-mobile.png";
---

<Base
  title="Screens — Inti Cerda"
  description="Interface captures: Compliance Monitor, the Media Intelligence marketing site, the internal operations panel and a family-law practice landing page."
>
  <section class="pagehead">
    <p class="pagehead__eyebrow">Screens</p>
    <h1>The front of the systems on the previous page.</h1>
    <p class="pagehead__body">
      Captured at 1440 and 390 wide. Product surfaces are in Spanish because
      every user of them is.
    </p>
  </section>

  <section>
    <p class="section__label">Product</p>

    <Shot
      desktop={complianceDesktop}
      mobile={complianceMobile}
      title="Compliance Monitor"
      caption="Regulatory monitoring for companies in regulated industries. Serif display type over a navy field, with the live index counts carried straight into the hero."
      tags={["Next.js 15", "Tailwind", "Live"]}
      href="https://compliancemonitor.cl"
    />

    <Shot
      desktop={landingDesktop}
      mobile={landingMobile}
      title="Media Intelligence — marketing site"
      caption="Marketing surface for the monitoring platform. The hero carries a simulated classification feed so the product's actual output is the first thing a visitor sees."
      tags={["Next.js 15", "Framer Motion", "Tailwind v4"]}
    />

    <Shot
      desktop={abogadaDesktop}
      mobile={abogadaMobile}
      title="Javiera Brandt — family law practice"
      caption="Client landing page for a family-law practice in Ovalle. Static Astro build, WhatsApp as the primary conversion path because that is how clients actually make first contact."
      tags={["Astro", "Tailwind v4", "Static"]}
    />
  </section>

  <section>
    <p class="section__label">Internal</p>

    <Shot
      desktop={adminDesktop}
      mobile={adminMobile}
      title="Operations panel — pipeline view"
      caption="Internal panel, never exposed publicly. Throughput, classification rate and LLM latency percentiles. Shown here with its offline fallback data, since the panel renders mock values whenever the backend is unreachable."
      tags={["Next.js 15", "Server Components", "Internal only"]}
    />
  </section>
</Base>
