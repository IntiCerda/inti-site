---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { stack, type Lang } from "../data/site";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    title: "Stack — Inti Cerda",
    description:
      "Languages, backend frameworks, frontend, AI tooling and infrastructure used in production.",
    eyebrow: "Stack",
    heading: "Tools I have shipped with, not tools I have read about.",
    intro:
      "Everything listed here is running in something that has real users. Where a choice was load-bearing, the reason is next to it.",
    layerLabel: "By layer",
    choicesLabel: "Choices worth explaining",
    choices: [
      {
        heading: "Local LLMs instead of an API",
        body: "Classification runs on Ollama against hardware I control. Two reasons: every article passes through three inference stages, so a hosted API would bill the same corpus three times over — and compliance customers are the least willing people on earth to let their data leave the building.",
      },
      {
        heading: "Redis Streams instead of a queue",
        body: "Consumer groups give each service its own cursor over the same log, so adding a consumer never touches the producer. Replay is free, which matters when a classifier changes and yesterday's articles need a second pass.",
      },
      {
        heading: "A database per service",
        body: "One PostgreSQL instance, many databases, no cross-service joins. It costs a little duplication and buys the ability to change one service's schema without a meeting.",
      },
      {
        heading: "JWKS at the gateway",
        body: "Traefik verifies RS256 signatures against a cached key set rather than calling the identity provider per request. Auth stops being a bottleneck, and claims like plan and rate limit ride along in the token.",
      },
    ],
  },
  es: {
    title: "Stack — Inti Cerda",
    description:
      "Lenguajes, frameworks de backend, frontend, herramientas de IA e infraestructura usados en producción.",
    eyebrow: "Stack",
    heading: "Herramientas con las que he entregado, no que solo he leído.",
    intro:
      "Todo lo listado aquí corre en algo con usuarios reales. Donde una elección fue estructural, la razón está al lado.",
    layerLabel: "Por capa",
    choicesLabel: "Elecciones que vale la pena explicar",
    choices: [
      {
        heading: "LLMs locales en vez de una API",
        body: "La clasificación corre en Ollama sobre hardware que controlo. Dos razones: cada artículo pasa por tres etapas de inferencia, así que una API alojada cobraría el mismo corpus tres veces — y los clientes de compliance son las personas menos dispuestas del mundo a dejar que sus datos salgan del edificio.",
      },
      {
        heading: "Redis Streams en vez de una cola",
        body: "Los consumer groups le dan a cada servicio su propio cursor sobre el mismo log, así que agregar un consumidor nunca toca al productor. El replay es gratis, y eso importa cuando un clasificador cambia y los artículos de ayer necesitan una segunda pasada.",
      },
      {
        heading: "Una base de datos por servicio",
        body: "Una instancia de PostgreSQL, muchas bases de datos, cero joins entre servicios. Cuesta un poco de duplicación y compra la capacidad de cambiar el esquema de un servicio sin una reunión.",
      },
      {
        heading: "JWKS en el gateway",
        body: "Traefik verifica firmas RS256 contra un key set cacheado en vez de llamar al proveedor de identidad en cada request. Auth deja de ser un cuello de botella, y claims como plan y rate limit viajan en el token.",
      },
    ],
  },
}[lang];
---

<Base title={copy.title} description={copy.description} lang={lang}>
  <section class="pagehead">
    <p class="pagehead__eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="pagehead__body">{copy.intro}</p>
  </section>

  <section>
    <p class="section__label">{copy.layerLabel}</p>
    <div class="groups reveal">
      {
        stack.map((group) => (
          <div class="group">
            <p class="group__name">{group.name[lang]}</p>
            <ul class="tags">
              {group.items.map((item) => (
                <li class="tag tag--icon">
                  <Icon slug={item.slug} label={item.label} />
                  {item.label}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <p class="section__label">{copy.choicesLabel}</p>
    <div class="cards cards--duo">
      {
        copy.choices.map((choice) => (
          <article class="card reveal">
            <h2>{choice.heading}</h2>
            <p class="card__body">{choice.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</Base>
