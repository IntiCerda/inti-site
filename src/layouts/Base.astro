---
// Mincho — the heavy Japanese serif of 80s/90s anime title cards — carries
// the display type. JetBrains Mono handles everything technical.
// Latin subsets only — the full families ship every Japanese glyph range and
// drag ~11MB of woff2 into the build. The latin subset covers Spanish
// (accents, ñ, ¿ ¡) as well as English, so both locales render from it.
import "@fontsource/shippori-mincho-b1/latin-700.css";
import "@fontsource/shippori-mincho-b1/latin-800.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "../styles/components.css";
import { nav, type Lang } from "../data/site";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = "en" } = Astro.props;

// Trailing slash is normalised so "/work" and "/work/" both mark the tab.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

// The same page in each language: "/es/work" strips to "/work", and each
// locale link rebuilds from that shared base path.
const basePath = (lang === "es" ? path.replace(/^\/es(\/|$)/, "/") : path) || "/";
const localeHref = (target: Lang, href = basePath) => {
  const clean = href.replace(/\/+$/, "") || "/";
  const prefixed = target === "es" ? (clean === "/" ? "/es" : `/es${clean}`) : clean;
  return prefixed === "/" ? "/" : `${prefixed}/`;
};

const isActive = (href: string) =>
  (localeHref(lang, href).replace(/\/+$/, "") || "/") === path;

const ui = {
  navLabel: { en: "Sections", es: "Secciones" },
  langLabel: { en: "Language", es: "Idioma" },
  themeLabel: { en: "Toggle light / dark theme", es: "Cambiar tema claro / oscuro" },
  skipLabel: { en: "Skip to content", es: "Saltar al contenido" },
  contactLabel: { en: "Contact", es: "Contacto" },
  footerMeta: {
    en: "Astro · no trackers · no cookies",
    es: "Astro · sin trackers · sin cookies",
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(localeHref(lang), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localeHref("en"), Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(localeHref("es"), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localeHref("en"), Astro.site)} />

    <script is:inline>
      // Set before first paint so revealed content is only ever hidden when
      // the script that reveals it is actually running.
      document.documentElement.classList.add("js");
      // Theme before first paint too — dark is the default; only an explicit
      // stored choice flips to light. localStorage can throw in private modes.
      try {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.dataset.theme = "light";
        }
      } catch {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(localeHref(lang), Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "es" ? "es_CL" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_CL"} />
    <meta name="twitter:card" content="summary_large_image" />

    <style is:global>
      /*
        Monochrome only — no hue anywhere. Structure carries the design:
        hard 2px rules, offset shadows with zero blur, and a mechanical
        press on every interactive surface.
      */
      /*
        Dark first: the page is ink-on-black by default and only inverts when
        the reader explicitly picks light with the topbar toggle. The choice
        persists in localStorage and is applied pre-paint via data-theme.
      */
      :root {
        color-scheme: dark;
        --bg: #0b0b0c;
        --paper: #141416;
        --ink: #ededea;
        --muted: #8e8e88;
        --rule: #2c2c2e;
        --shadow: 6px 6px 0 var(--ink);
        --shadow-sm: 4px 4px 0 var(--ink);

        /*
          Buttons stay white-faced with black text in BOTH themes — the drop
          shadow is the only part that re-tints, so it stays visible against a
          near-black background instead of disappearing into it.
        */
        --btn-face: #ffffff;
        --btn-ink: #0a0a0a;
        --btn-shadow: #5a5a5a;

        --measure: 74rem;
        --border: 2px;

        --display: "Shippori Mincho B1", "Hiragino Mincho ProN", "Yu Mincho",
          Georgia, "Times New Roman", serif;
        --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas,
          monospace;
        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
      }

      :root[data-theme="light"] {
        color-scheme: light;
        --bg: #f2f1ec;
        --paper: #ffffff;
        --ink: #0d0d0e;
        --muted: #67675f;
        --rule: #d5d4cd;
        --btn-shadow: #0d0d0e;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-padding-top: 6rem;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 1rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      /*
        Screentone: the halftone dot fill used to shade black-and-white manga
        panels. Faded out below the fold so it reads as atmosphere, not pattern.
      */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.5;
        background-image: radial-gradient(
          var(--rule) 1px,
          transparent 1.2px
        );
        background-size: 6px 6px;
        mask-image: radial-gradient(
          ellipse 110% 70% at 50% 0%,
          #000,
          transparent
        );
      }

      .shell {
        max-width: var(--measure);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /*
        Type scale, ~1.4 between steps so the jumps are unmistakable:
        display 64 → h1 44 → h2 24 → body 16 → label 12.
      */
      h1,
      h2,
      h3 {
        font-family: var(--display);
        font-weight: 700;
        letter-spacing: -0.01em;
        margin: 0;
        text-wrap: balance;
      }

      .t-display {
        font-weight: 800;
        font-size: clamp(2.75rem, 1.6rem + 5.2vw, 4.25rem);
        line-height: 1.06;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: clamp(2rem, 1.5rem + 2.2vw, 2.875rem);
        line-height: 1.15;
      }

      h2 {
        font-size: 1.5rem;
        line-height: 1.2;
      }

      h3 {
        font-size: 1.125rem;
        line-height: 1.3;
      }

      p {
        margin: 0 0 1rem;
      }

      a {
        color: inherit;
      }

      :focus-visible {
        outline: 3px solid var(--ink);
        outline-offset: 3px;
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      /* Hidden until keyboard focus, then a hard-bordered plate over the bar. */
      .skiplink {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 30;
        transform: translateY(-200%);
        background: var(--btn-face);
        color: var(--btn-ink);
        border: var(--border) solid var(--btn-ink);
        box-shadow: 4px 4px 0 var(--btn-shadow);
        font-family: var(--mono);
        font-size: 0.8125rem;
        font-weight: 700;
        text-decoration: none;
        padding: 0.625rem 1rem;
      }

      .skiplink:focus-visible {
        transform: none;
      }

      /* ---- Top bar ---- */

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--bg);
        border-bottom: var(--border) solid var(--ink);
      }

      .topbar__inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        align-items: flex-end;
        justify-content: space-between;
        padding-block: 0.875rem 0;
      }

      .topbar__name {
        font-family: var(--mono);
        font-weight: 700;
        text-decoration: none;
        letter-spacing: -0.02em;
        padding-bottom: 0.875rem;
      }

      .topbar__nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.8125rem;
      }

      /*
        Tabs sit on the bar's own bottom rule: the active one covers it, so the
        current page reads as physically connected to the content below.
      */
      .tab {
        position: relative;
        bottom: calc(var(--border) * -1);
        text-decoration: none;
        padding: 0.5rem 0.875rem;
        border: var(--border) solid transparent;
        border-bottom: none;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }

      .tab:hover {
        background: var(--paper);
      }

      .tab--active {
        background: var(--bg);
        border-color: var(--ink);
        font-weight: 700;
      }

      /* Masks the bar's bottom rule directly under the active tab. */
      .tab--active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: var(--border);
        background: var(--bg);
      }

      /* ---- Topbar tools: language switch + theme toggle ---- */

      .topbar__tools {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.625rem;
        font-family: var(--mono);
        font-size: 0.8125rem;
      }

      .langswitch {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        color: var(--muted);
      }

      .langswitch__opt {
        text-decoration: none;
        color: var(--muted);
        padding: 0.375rem 0.375rem;
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
      }

      .langswitch__opt:hover {
        color: var(--ink);
      }

      .langswitch__opt--active {
        color: var(--ink);
        font-weight: 700;
        text-decoration: underline;
        text-decoration-thickness: var(--border);
        text-underline-offset: 5px;
      }

      /* Same mechanical press as .btn, scaled down to a square. */
      .themetoggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        border: var(--border) solid var(--ink);
        box-shadow: 3px 3px 0 var(--btn-shadow);
        cursor: pointer;
        transition:
          transform 150ms ease,
          box-shadow 150ms ease;
      }

      .themetoggle:hover,
      .themetoggle:focus-visible {
        transform: translate(3px, 3px);
        box-shadow: 0 0 0 var(--btn-shadow);
      }

      /* The half-moon flips when the theme does. */
      .themetoggle svg {
        transition: transform 300ms ease;
      }

      :root[data-theme="light"] .themetoggle svg {
        transform: rotate(180deg);
      }

      /*
        Narrow screens: tools share the first row with the name, and the tabs
        collapse to a single horizontally scrollable row. Both keep the sticky
        bar near 110px instead of 200+.
      */
      @media (max-width: 56rem) {
        .topbar__nav {
          order: 1;
          width: 100%;
          flex-wrap: nowrap;
          overflow-x: auto;
          scrollbar-width: none;
        }

        .topbar__nav::-webkit-scrollbar {
          display: none;
        }

        .tab {
          flex: none;
          white-space: nowrap;
          /* The rule-masking trick needs overflow: visible; inside a scroll
             container it clips, so tabs sit flush instead. */
          bottom: 0;
        }

        .tab--active::after {
          display: none;
        }
      }

      .footer__links {
        display: flex;
        gap: 1.25rem;
      }

      .footer__links a {
        color: inherit;
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
      }

      /* ---- Buttons: white face, black text, black border, hard shadow ---- */

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.875rem;
        font-weight: 700;
        text-decoration: none;
        padding: 0.625rem 1.125rem;
        min-height: 44px;
        cursor: pointer;
        background: var(--btn-face);
        color: var(--btn-ink);
        border: var(--border) solid var(--btn-ink);
        box-shadow: 4px 4px 0 var(--btn-shadow);
        transition:
          transform 150ms ease,
          box-shadow 150ms ease;
      }

      .btn:hover,
      .btn:focus-visible {
        transform: translate(4px, 4px);
        box-shadow: 0 0 0 var(--btn-shadow);
      }

      .btn--solid {
        background: var(--btn-ink);
        color: var(--btn-face);
        border-color: var(--ink);
      }

      /* ---- Section scaffold: identical every time ---- */

      section {
        margin-top: 6rem;
        scroll-margin-top: 6rem;
      }

      .section__label {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 1.75rem;
      }

      .section__label::before {
        content: "";
        width: 0.625rem;
        height: 0.625rem;
        background: var(--ink);
        flex: none;
      }

      .section__label::after {
        content: "";
        flex: 1;
        height: var(--border);
        background: var(--rule);
      }

      /* ---- Scroll reveal ---- */

      /*
        Scoped to .js so the content is never hidden when the script fails to
        run — without this, a JS error would leave the page blank.
      */
      .js .reveal {
        opacity: 0;
        transform: translateY(1rem);
        transition:
          opacity 450ms ease,
          transform 450ms ease;
      }

      .js .reveal.is-in {
        opacity: 1;
        transform: none;
      }

      /*
        Motion is decoration here, never information. With reduced motion the
        page is fully legible and every revealed element starts visible.
      */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }

        .js .reveal {
          opacity: 1;
          transform: none;
        }
      }

      footer {
        margin-top: 6rem;
        border-top: var(--border) solid var(--ink);
        padding-block: 1.5rem 3rem;
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        justify-content: space-between;
      }
    </style>
  </head>

  <body>
    <a class="skiplink" href="#main">{ui.skipLabel[lang]}</a>
    <header class="topbar">
      <div class="shell topbar__inner">
        <a class="topbar__name" href={localeHref(lang, "/")}>INTI CERDA</a>
        <nav class="topbar__nav" aria-label={ui.navLabel[lang]}>
          {
            nav.map((item) => (
              <a
                href={localeHref(lang, item.href)}
                class:list={["tab", { "tab--active": isActive(item.href) }]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label[lang]}
              </a>
            ))
          }
        </nav>
        <div class="topbar__tools">
          <nav class="langswitch" aria-label={ui.langLabel[lang]}>
            <a
              href={localeHref("en")}
              hreflang="en"
              class:list={["langswitch__opt", { "langswitch__opt--active": lang === "en" }]}
              aria-current={lang === "en" ? "true" : undefined}
            >
              EN
            </a>
            <span aria-hidden="true">/</span>
            <a
              href={localeHref("es")}
              hreflang="es"
              class:list={["langswitch__opt", { "langswitch__opt--active": lang === "es" }]}
              aria-current={lang === "es" ? "true" : undefined}
            >
              ES
            </a>
          </nav>
          <button id="theme-toggle" class="themetoggle" aria-label={ui.themeLabel[lang]}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <circle cx="8" cy="8" r="6.75" fill="none" stroke="currentColor" stroke-width="2"></circle>
              <path d="M8 1.25 A6.75 6.75 0 0 1 8 14.75 Z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="shell">
      <slot />
    </main>

    <div class="shell">
      <footer>
        <span>Inti Cerda — Coquimbo, Chile</span>
        <nav class="footer__links" aria-label={ui.contactLabel[lang]}>
          <a href="mailto:inti.cerda.r@gmail.com">Email</a>
          <a href="https://github.com/IntiCerda">GitHub</a>
          <a href="https://www.linkedin.com/in/inti-cerda/">LinkedIn</a>
        </nav>
        <span>{ui.footerMeta[lang]}</span>
      </footer>
    </div>

    <script>
      // Theme toggle: dark is the default state (no data-theme attribute);
      // light is the explicit, stored exception. aria-pressed = light active.
      {
        const toggle = document.getElementById("theme-toggle");
        const root = document.documentElement;
        const syncPressed = () =>
          toggle?.setAttribute(
            "aria-pressed",
            String(root.dataset.theme === "light"),
          );
        syncPressed();
        toggle?.addEventListener("click", () => {
          const next = root.dataset.theme === "light" ? "dark" : "light";
          if (next === "light") {
            root.dataset.theme = "light";
          } else {
            delete root.dataset.theme;
          }
          syncPressed();
          try {
            localStorage.setItem("theme", next);
          } catch {}
        });
      }

      // Reveal on scroll, and count up any [data-count] once it is in view.
      const motionOK = !window.matchMedia("(prefers-reduced-motion: reduce)")
        .matches;

      const counted = new WeakSet<Element>();

      // The element already renders its final value server-side, so a stalled
      // rAF or a JS failure leaves the real number on screen, not a zero.
      function runCount(el: HTMLElement) {
        const target = Number(el.dataset.count);
        if (!Number.isFinite(target) || !motionOK) return;

        el.textContent = "0";
        const duration = 900;
        const start = performance.now();

        function tick(now: number) {
          const p = Math.min((now - start) / duration, 1);
          // easeOutCubic — fast start, settles rather than snapping.
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;

            entry.target.classList.add("is-in");

            for (const n of entry.target.querySelectorAll<HTMLElement>(
              "[data-count]",
            )) {
              if (counted.has(n)) continue;
              counted.add(n);
              runCount(n);
            }

            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
      );

      const targets = [...document.querySelectorAll(".reveal")];

      for (const el of targets) {
        observer.observe(el);
      }

      // Safety net: hidden-until-observed content must never get stuck hidden.
      // If the observer has delivered nothing shortly after load, reveal
      // everything rather than leave the page blank.
      window.setTimeout(() => {
        if (document.querySelector(".reveal.is-in")) return;

        for (const el of targets) {
          el.classList.add("is-in");
          for (const n of el.querySelectorAll<HTMLElement>("[data-count]")) {
            if (counted.has(n)) continue;
            counted.add(n);
            runCount(n);
          }
        }
      }, 2500);
    </script>
  </body>
</html>
