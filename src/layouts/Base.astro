---
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";
import "../styles/components.css";
import { nav } from "../data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Trailing slash is normalised so "/work" and "/work/" both mark the tab.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => (href.replace(/\/+$/, "") || "/") === path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      // Set before first paint so revealed content is only ever hidden when
      // the script that reveals it is actually running.
      document.documentElement.classList.add("js");
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />

    <style is:global>
      /*
        Monochrome only — no hue anywhere. Structure carries the design:
        hard 2px rules, offset shadows with zero blur, and a mechanical
        press on every interactive surface.
      */
      :root {
        --bg: #f4f4f2;
        --paper: #ffffff;
        --ink: #0a0a0a;
        --muted: #6b6b6b;
        --rule: #d8d8d6;
        --shadow: 6px 6px 0 var(--ink);
        --shadow-sm: 4px 4px 0 var(--ink);

        /*
          Buttons stay white-faced with black text in BOTH themes — the drop
          shadow is the only part that re-tints, so it stays visible against a
          near-black background instead of disappearing into it.
        */
        --btn-face: #ffffff;
        --btn-ink: #0a0a0a;
        --btn-shadow: #0a0a0a;

        --measure: 74rem;
        --border: 2px;

        --mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, Consolas,
          monospace;
        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0c0c0c;
          --paper: #161616;
          --ink: #f2f2f2;
          --muted: #9a9a9a;
          --rule: #2a2a2a;
          --btn-shadow: #5a5a5a;
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-padding-top: 6rem;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 1rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      /* Faint grid, so the flat background still reads as a surface. */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.35;
        background-image: linear-gradient(
            var(--rule) var(--border),
            transparent var(--border)
          ),
          linear-gradient(90deg, var(--rule) var(--border), transparent var(--border));
        background-size: 4rem 4rem;
        mask-image: radial-gradient(ellipse 100% 60% at 50% 0%, #000, transparent);
      }

      .shell {
        max-width: var(--measure);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /*
        Type scale, ~1.4 between steps so the jumps are unmistakable:
        display 64 → h1 44 → h2 24 → body 16 → label 12.
      */
      h1,
      h2,
      h3 {
        font-family: var(--mono);
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0;
        text-wrap: balance;
      }

      .t-display {
        font-size: clamp(2.75rem, 1.6rem + 5.2vw, 4rem);
        line-height: 0.98;
        letter-spacing: -0.05em;
      }

      h1 {
        font-size: clamp(2rem, 1.5rem + 2.2vw, 2.75rem);
        line-height: 1.08;
      }

      h2 {
        font-size: 1.5rem;
        line-height: 1.2;
      }

      h3 {
        font-size: 1.125rem;
        line-height: 1.3;
      }

      p {
        margin: 0 0 1rem;
      }

      a {
        color: inherit;
      }

      :focus-visible {
        outline: 3px solid var(--ink);
        outline-offset: 3px;
      }

      /* ---- Top bar ---- */

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--bg);
        border-bottom: var(--border) solid var(--ink);
      }

      .topbar__inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        align-items: flex-end;
        justify-content: space-between;
        padding-block: 0.875rem 0;
      }

      .topbar__name {
        font-family: var(--mono);
        font-weight: 700;
        text-decoration: none;
        letter-spacing: -0.02em;
        padding-bottom: 0.875rem;
      }

      .topbar__nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.8125rem;
      }

      /*
        Tabs sit on the bar's own bottom rule: the active one covers it, so the
        current page reads as physically connected to the content below.
      */
      .tab {
        position: relative;
        bottom: calc(var(--border) * -1);
        text-decoration: none;
        padding: 0.5rem 0.875rem;
        border: var(--border) solid transparent;
        border-bottom: none;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }

      .tab:hover {
        background: var(--paper);
      }

      .tab--active {
        background: var(--bg);
        border-color: var(--ink);
        font-weight: 700;
      }

      /* Masks the bar's bottom rule directly under the active tab. */
      .tab--active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: var(--border);
        background: var(--bg);
      }

      /* ---- Buttons: white face, black text, black border, hard shadow ---- */

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.875rem;
        font-weight: 700;
        text-decoration: none;
        padding: 0.625rem 1.125rem;
        min-height: 44px;
        cursor: pointer;
        background: var(--btn-face);
        color: var(--btn-ink);
        border: var(--border) solid var(--btn-ink);
        box-shadow: 4px 4px 0 var(--btn-shadow);
        transition:
          transform 150ms ease,
          box-shadow 150ms ease;
      }

      .btn:hover,
      .btn:focus-visible {
        transform: translate(4px, 4px);
        box-shadow: 0 0 0 var(--btn-shadow);
      }

      .btn--solid {
        background: var(--btn-ink);
        color: var(--btn-face);
        border-color: var(--ink);
      }

      /* ---- Section scaffold: identical every time ---- */

      section {
        margin-top: 6rem;
        scroll-margin-top: 6rem;
      }

      .section__label {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 1.75rem;
      }

      .section__label::before {
        content: "";
        width: 0.625rem;
        height: 0.625rem;
        background: var(--ink);
        flex: none;
      }

      .section__label::after {
        content: "";
        flex: 1;
        height: var(--border);
        background: var(--rule);
      }

      /* ---- Scroll reveal ---- */

      /*
        Scoped to .js so the content is never hidden when the script fails to
        run — without this, a JS error would leave the page blank.
      */
      .js .reveal {
        opacity: 0;
        transform: translateY(1rem);
        transition:
          opacity 450ms ease,
          transform 450ms ease;
      }

      .js .reveal.is-in {
        opacity: 1;
        transform: none;
      }

      /*
        Motion is decoration here, never information. With reduced motion the
        page is fully legible and every revealed element starts visible.
      */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }

        .js .reveal {
          opacity: 1;
          transform: none;
        }
      }

      footer {
        margin-top: 6rem;
        border-top: var(--border) solid var(--ink);
        padding-block: 1.5rem 3rem;
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        justify-content: space-between;
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="shell topbar__inner">
        <a class="topbar__name" href="/">INTI CERDA</a>
        <nav class="topbar__nav" aria-label="Sections">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={["tab", { "tab--active": isActive(item.href) }]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <div class="shell">
      <footer>
        <span>Inti Cerda — Coquimbo, Chile</span>
        <span>Astro · no trackers · no cookies</span>
      </footer>
    </div>

    <script>
      // Reveal on scroll, and count up any [data-count] once it is in view.
      const motionOK = !window.matchMedia("(prefers-reduced-motion: reduce)")
        .matches;

      const counted = new WeakSet<Element>();

      // The element already renders its final value server-side, so a stalled
      // rAF or a JS failure leaves the real number on screen, not a zero.
      function runCount(el: HTMLElement) {
        const target = Number(el.dataset.count);
        if (!Number.isFinite(target) || !motionOK) return;

        el.textContent = "0";
        const duration = 900;
        const start = performance.now();

        function tick(now: number) {
          const p = Math.min((now - start) / duration, 1);
          // easeOutCubic — fast start, settles rather than snapping.
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;

            entry.target.classList.add("is-in");

            for (const n of entry.target.querySelectorAll<HTMLElement>(
              "[data-count]",
            )) {
              if (counted.has(n)) continue;
              counted.add(n);
              runCount(n);
            }

            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
      );

      const targets = [...document.querySelectorAll(".reveal")];

      for (const el of targets) {
        observer.observe(el);
      }

      // Safety net: hidden-until-observed content must never get stuck hidden.
      // If the observer has delivered nothing shortly after load, reveal
      // everything rather than leave the page blank.
      window.setTimeout(() => {
        if (document.querySelector(".reveal.is-in")) return;

        for (const el of targets) {
          el.classList.add("is-in");
          for (const n of el.querySelectorAll<HTMLElement>("[data-count]")) {
            if (counted.has(n)) continue;
            counted.add(n);
            runCount(n);
          }
        }
      }, 2500);
    </script>
  </body>
</html>
