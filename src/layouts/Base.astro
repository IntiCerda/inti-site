---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />

    <style is:global>
      /*
        Grayscale only. No accent hue anywhere — hierarchy comes from
        weight, size and spacing, never from color.
      */
      :root {
        --bg: #fafafa;
        --surface: #ffffff;
        --text: #1a1a1a;
        --muted: #6e6e6e;
        --rule: #dcdcdc;

        --measure: 68ch;
        --gap: 1rem;
        --section-gap: 4.5rem;

        --font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
          "Liberation Mono", monospace;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e0e0e;
          --surface: #151515;
          --text: #e9e9e9;
          --muted: #9b9b9b;
          --rule: #2b2b2b;
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        /* Anchors land below the fixed top rule instead of under it. */
        scroll-padding-top: 5rem;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font);
        font-size: 1rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      /*
        Nothing animates. Every state change is instant, so the page never
        moves on its own and hover feedback is immediate rather than eased.
      */
      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }
      }

      .shell {
        max-width: var(--measure);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* ---- Top bar: same height and position on every page ---- */

      .topbar {
        border-bottom: 1px solid var(--rule);
        background: var(--bg);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .topbar__inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        align-items: baseline;
        justify-content: space-between;
        padding-block: 1rem;
      }

      .topbar__name {
        font-weight: 600;
        letter-spacing: -0.01em;
        text-decoration: none;
        color: var(--text);
      }

      .topbar__nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        font-family: var(--mono);
        font-size: 0.8125rem;
      }

      .topbar__nav a {
        color: var(--muted);
        text-decoration: none;
      }

      .topbar__nav a:hover,
      .topbar__nav a:focus-visible {
        color: var(--text);
      }

      /* ---- Section: identical scaffold every time ---- */

      section {
        margin-top: var(--section-gap);
      }

      .section__label {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 1.75rem;
      }

      .section__label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--rule);
      }

      h1 {
        font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.5rem);
        line-height: 1.2;
        letter-spacing: -0.025em;
        margin: 0 0 1rem;
        font-weight: 600;
      }

      h2 {
        font-size: 1.0625rem;
        line-height: 1.35;
        margin: 0 0 0.375rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      p {
        margin: 0 0 1rem;
      }

      a {
        color: var(--text);
        text-underline-offset: 0.2em;
        text-decoration-color: var(--rule);
      }

      a:hover,
      a:focus-visible {
        text-decoration-color: var(--text);
      }

      :focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .lede {
        font-size: 1.0625rem;
        color: var(--muted);
        max-width: 56ch;
      }

      /* ---- Project entries ---- */

      .entry {
        padding-block: 1.5rem;
        border-top: 1px solid var(--rule);
      }

      .entry:last-child {
        border-bottom: 1px solid var(--rule);
      }

      .entry__meta {
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
        margin-bottom: 0.5rem;
      }

      .entry__body {
        color: var(--muted);
        margin: 0 0 0.75rem;
      }

      .entry__links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        font-family: var(--mono);
        font-size: 0.8125rem;
      }

      /* ---- Labeled groups (stack) ---- */

      .group {
        padding-block: 1rem;
        border-top: 1px solid var(--rule);
        display: grid;
        grid-template-columns: 9rem 1fr;
        gap: 0.25rem 1.5rem;
        align-items: baseline;
      }

      .group:last-child {
        border-bottom: 1px solid var(--rule);
      }

      .group__name {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .group__items {
        margin: 0;
      }

      @media (max-width: 34rem) {
        .group {
          grid-template-columns: 1fr;
        }
      }

      /* ---- Contact ---- */

      .contact {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 9rem 1fr;
        gap: 0.5rem 1.5rem;
        font-size: 0.9375rem;
      }

      .contact dt {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .contact dd {
        margin: 0;
      }

      @media (max-width: 34rem) {
        .contact {
          grid-template-columns: 1fr;
        }

        .contact dd {
          margin-bottom: 0.5rem;
        }
      }

      footer {
        margin-top: var(--section-gap);
        padding-block: 1.5rem 3rem;
        border-top: 1px solid var(--rule);
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="shell topbar__inner">
        <a class="topbar__name" href="/">Inti Cerda</a>
        <nav class="topbar__nav" aria-label="Sections">
          <a href="#work">Work</a>
          <a href="#stack">Stack</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <div class="shell">
      <footer>Built with Astro. No trackers, no cookies.</footer>
    </div>
  </body>
</html>
