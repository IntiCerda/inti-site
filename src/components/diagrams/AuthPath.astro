<svg viewBox="0 0 820 250" role="img" aria-labelledby="authTitle">
  <title id="authTitle">
    Traefik verifies every request with forwardAuth, then checks the JWT
    signature against a cached JWKS instead of calling the identity provider
    each time.
  </title>

  <rect class="dg-box" x="20" y="90" width="130" height="56"></rect>
  <text class="dg-label" x="34" y="116">Client</text>
  <text class="dg-sub" x="34" y="133">JWT bearer</text>

  <path class="dg-line" d="M150 118 L235 118"></path>
  <path class="dg-line" d="M225 112 L235 118 L225 124"></path>

  <rect class="dg-box" x="235" y="90" width="175" height="56"></rect>
  <text class="dg-label" x="249" y="116">media-gateway</text>
  <text class="dg-sub" x="249" y="133">Traefik v3 · forwardAuth</text>

  <!-- JWKS side trip -->
  <path class="dg-line" d="M322 90 L322 40 L520 40"></path>
  <path class="dg-line" d="M510 34 L520 40 L510 46"></path>
  <rect class="dg-box" x="520" y="12" width="160" height="56"></rect>
  <text class="dg-label" x="534" y="38">media-auth</text>
  <text class="dg-sub" x="534" y="55">RS256 · JWKS</text>
  <text class="dg-note" x="332" y="32">public keys, cached</text>

  <path class="dg-line" d="M410 118 L495 118"></path>
  <path class="dg-line" d="M485 112 L495 118 L485 124"></path>

  <rect class="dg-box" x="495" y="90" width="185" height="56"></rect>
  <text class="dg-label" x="509" y="116">downstream service</text>
  <text class="dg-sub" x="509" y="133">org_id · plan · rate_limit</text>

  <rect class="dg-packet" x="30" y="113" width="9" height="9" style="--to:640px"
  ></rect>
  <rect
    class="dg-packet"
    x="30"
    y="113"
    width="9"
    height="9"
    style="--to:640px;--d:1.6s"></rect>

  <text class="dg-note" x="20" y="200">
    Claims travel in the token, so no service needs a lookup to know the
    caller's plan.
  </text>
</svg>
