---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../data/site";

interface Props {
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  title: string;
  caption: string;
  tags: string[];
  href?: string;
  lang?: Lang;
}

const { desktop, mobile, title, caption, tags, href, lang = "en" } = Astro.props;

const ui = {
  desktopAlt: { en: "desktop view", es: "vista de escritorio" },
  mobileAlt: { en: "mobile view", es: "vista móvil" },
  visit: { en: "Visit →", es: "Visitar →" },
};
---

<figure class="shot reveal">
  <div class="shot__frames">
    <div class="shot__desktop">
      <Image
        src={desktop}
        alt={`${title} — ${ui.desktopAlt[lang]}`}
        widths={[640, 960, 1280]}
        sizes="(max-width: 60rem) 100vw, 60vw"
        format="webp"
        quality={72}
        loading="lazy"
      />
    </div>
    <div class="shot__mobile">
      <Image
        src={mobile}
        alt={`${title} — ${ui.mobileAlt[lang]}`}
        widths={[240, 390]}
        sizes="240px"
        format="webp"
        quality={72}
        loading="lazy"
      />
    </div>
  </div>

  <figcaption class="shot__caption">
    <div>
      <p class="shot__title">{title}</p>
      <p class="shot__text">{caption}</p>
    </div>
    <ul class="tags">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    {
      href && (
        <p class="shot__link">
          <a class="btn" href={href}>
            {ui.visit[lang]}
          </a>
        </p>
      )
    }
  </figcaption>
</figure>

<style>
  .shot {
    margin: 0 0 2rem;
    border: var(--border) solid var(--ink);
    background: var(--paper);
  }

  .shot__frames {
    display: grid;
    grid-template-columns: 1fr 15rem;
    align-items: end;
    gap: 1.5rem;
    padding: clamp(1rem, 0.6rem + 1.6vw, 2rem);
  }

  .shot__desktop img,
  .shot__mobile img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border) solid var(--ink);
  }

  .shot__desktop img {
    box-shadow: var(--shadow-sm);
  }

  .shot__mobile img {
    box-shadow: var(--shadow-sm);
  }

  .shot__caption {
    border-top: var(--border) solid var(--ink);
    padding: 1.25rem;
    display: grid;
    gap: 1rem;
  }

  .shot__title {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 0.25rem;
  }

  .shot__text {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 68ch;
  }

  .shot__link {
    margin: 0;
  }

  @media (max-width: 60rem) {
    .shot__frames {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .shot__mobile {
      max-width: 14rem;
    }
  }
</style>
