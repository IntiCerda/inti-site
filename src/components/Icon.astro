---
import * as simpleIcons from "simple-icons";

interface Props {
  slug?: string;
  label: string;
  size?: number;
}

const { slug, label, size = 16 } = Astro.props;

// simple-icons exports siTypescript, siNextdotjs, … from the slug.
const key = slug
  ? `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}`
  : undefined;
const icon = key
  ? (simpleIcons as Record<string, { path: string } | undefined>)[key]
  : undefined;

// Not every tool has a brand mark — those fall back to a monogram so the row
// keeps its rhythm instead of collapsing.
const monogram = label.replace(/[^A-Za-z]/g, "").slice(0, 2).toUpperCase();
---

{
  icon ? (
    <svg
      class="icon"
      role="img"
      aria-hidden="true"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="currentColor"
    >
      <path d={icon.path} />
    </svg>
  ) : (
    <span class="icon icon--mono" aria-hidden="true">
      {monogram}
    </span>
  )
}

<style>
  .icon {
    flex: none;
    display: block;
  }

  .icon--mono {
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    font-family: var(--mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0;
    border: 1px solid currentColor;
  }
</style>
